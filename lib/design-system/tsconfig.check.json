{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "es2022"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "src",
    "scripts",
    "tests",
    ".storybook",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["storybook-static", "dist", "node_modules"]
}
