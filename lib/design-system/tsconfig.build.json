{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["react", "vite/client"]
  },
  "include": [
    "src/index.ts",
    "src/theme/**/*.ts",
    "src/theme/**/*.tsx",
    "src/components/Button/Button.tsx",
    "src/plugins/breakpoint-media.ts",
    "src/generated/token-types.ts",
    "src/generated/breakpoint-media.ts",
    "src/styles.d.ts"
  ]
}
