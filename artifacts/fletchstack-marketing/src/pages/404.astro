---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<BaseLayout
  title="Page not found | FletchStack"
  description="The page you’re looking for could not be found. Return to FletchStack to explore its software development services."
>
  <SiteHeader base={base} />
  <main id="main-content">
    <section class="page-intro">
      <div class="page-intro-inner">
        <span class="eyebrow">404 / Page not found</span>
        <h1>This page isn’t in the stack.</h1>
        <p class="intro-copy">
          The address may be out of date, or the page may have moved. Head back
          to FletchStack and find a useful next step.
        </p>
        <a class="button" href={base}>Return to the homepage</a>
      </div>
    </section>
  </main>
  <SiteFooter base={base} />
</BaseLayout>
